# Leak-gate committed baseline — sourced by tools/leak_gate.sh
# Measured 2026-08-01 against tools/leak_gate_reference_synthetic.csv.
# The reference is SYNTHETIC (not a real capture); this baseline is a
# relative tracking number, not proof of resistance to traffic analysis.
BASELINE_KL=0.997831
BASELINE_DATE=2026-08-01
BASELINE_REFERENCE=leak_gate_reference_synthetic.csv
# Emitter conditions the baseline was measured under. MUST stay pinned:
# KL is stable across sample sizes (0.947-1.075 over 22-452 records), but
# the emitter's spectral peak_ratio exceeds the 8.0 threshold for any run
# longer than 60 ticks (33.9 @ 240, 169.7 @ 1200), so the baseline is only
# comparable at exactly these conditions.
BASELINE_TICKS=60
BASELINE_RECORDS=22
# No-regression tolerance in nats. Chosen as ~10% of the baseline and above
# the largest cross-sample-size KL spread observed (1.075 - 0.998 = 0.077),
# so only a genuine worsening of the size distribution trips the gate.
KL_TOLERANCE=0.10
