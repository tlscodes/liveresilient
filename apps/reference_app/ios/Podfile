# flutter_webrtc 1.5.2's podspec (flutter_webrtc.podspec) declares
# `s.ios.deployment_target = '13.0'` — match it here so CocoaPods doesn't
# fall back to Flutter's older default deployment target.
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  # T2: vendored codec frameworks (codec2/dav1d/SVT-AV1/avif) for Dart FFI —
  # built by tools/phase5/native/build_ios_xcframeworks.sh, pinned in
  # PROVENANCE.tsv. Local path pod; nothing fetched from the network.
  pod 'NativeCodecs', :path => 'NativeCodecs'
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # PtTransport.xcframework's simulator slice is x86_64-only, and the
      # CocoaPods slice selector requires ONE slice covering EVERY arch in
      # ARCHS ("arm64 x86_64" by default on Xcode 12+), so simulator links
      # failed with "Framework 'PtTransport' not found". This host is an
      # Intel Mac — an arm64 simulator cannot run here, so excluding it
      # discards nothing real. Durable fix when the engine is rebuilt:
      # regenerate the xcframework with an arm64_x86_64 simulator slice
      # (engine/pt/tools/make_xcframework.sh) and drop this exclusion.
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end
end
